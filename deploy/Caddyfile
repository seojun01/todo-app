# Caddy 설정: TLS(내부 CA) 종료, 정적 파일(PWA) 제공, /api/* 를 Node 서버로 프록시
# 설치 위치: /etc/caddy/Caddyfile  (deploy/install.sh 가 복사한다)
#
# 주소는 사용하는 내부 DNS 의 이름과 같아야 한다.
todo.home.arpa {
	# 외부 CA 에 의존하지 않는다: Caddy 내부 CA 가 서버 인증서를 만들고 자동으로 갱신한다.
	# 각 기기에 루트 인증서(/var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt)를 한 번 설치해 신뢰한다.
	tls internal

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# API: SSE(/api/events)가 버퍼링되지 않도록 즉시 전달한다. 압축은 걸지 않는다(SSE 가 밀리지 않게).
	handle /api/* {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}

	# 앱 셸: 서비스 워커와 index.html 은 항상 최신을 확인하게 한다.
	handle {
		root * /opt/todo/client/dist
		encode zstd gzip
		@shell path /sw.js /index.html /
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
